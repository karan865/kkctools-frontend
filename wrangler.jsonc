{
  // Static-only deploy: Next.js `output: 'export'` writes the site to ./out,
  // and Cloudflare serves it as Workers Static Assets. No server code, no OpenNext.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kkctools-frontend",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
